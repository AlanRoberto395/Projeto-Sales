@model IEnumerable<SalesWebMvc.Models.ViewModels.SalesRecord>

@{
    ViewData["Title"] = "Simple Search";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card mb-4">
    <div class="card-body">
        <form class="row g-3 align-items-end" role="search">
            <div class="col-auto">
                <label for="minDate" class="form-label">Min Date</label>
                <input type="date" class="form-control" name="minDate" value="@ViewData["minDate"]" />
            </div>
            <div class="col-auto">
                <label for="maxDate" class="form-label">Max Date</label>
                <input type="date" class="form-control" name="maxDate" value="@ViewData["maxDate"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title h5 mb-0">Total sales = @Model.Sum(obj => obj.Amount).ToString("F2")</h3>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Date</th>
                        <th>Seller</th>
                        <th>Department</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Date.ToString("dd/MM/yyyy")</td>
                            <td>@item.Seller.Name</td>
                            <td>@item.Seller.Department.Name</td>
                            <td class="text-end">@item.Amount.ToString("F2")</td>
                            <td>
                                <span class="badge @(item.Status.ToString() == "Billed" ? "bg-success" : item.Status.ToString() == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                                    @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>